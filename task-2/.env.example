# Supabase (Lovable Cloud) — publishable / anon keys only.
# These are safe to ship to the browser; row-level security enforces access.
# Copy to `.env` and fill in your own project values (or use the ones from the
# Lovable project this repo was forked from).

SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-anon-key>"

VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-anon-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"
